{
  "manifest_version": 3,
  "name": "OmaSwitch Tabs",
  "version": "1.0",
  "description": "Shares recently used tabs with the OmaSwitch Alt+Tab switcher and activates the tab you pick.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
